<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaProbe</AssemblyName>
    <RootNamespace>MediaProbe</RootNamespace>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 引用 WPF 项目才能调 MediaSessionPick，需要目标框架对得上 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接调产品代码里的选取判据，而不是把它复制一份过来 ——
         要验的必须是真正跑在岛体上的那份实现（与 WeatherProbe / BridgeViz 同一个理由）。 -->
    <ProjectReference Include="..\..\src\IslandX.App\IslandX.App.csproj" />
  </ItemGroup>

</Project>
