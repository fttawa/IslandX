<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 19041 是为了拿到 CsWinRT 投影：定位走 Windows.Devices.Geolocation -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WeatherProbe</AssemblyName>
    <RootNamespace>WeatherProbe</RootNamespace>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <!-- 引用的是 WPF 项目（要跑它里面的 Weather 判据），需要 WPF 目标框架对得上 -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接调产品代码里的 Weather，而不是把判据复制一份过来 ——
         验证的必须是真正跑在岛体上的那份实现（与 BridgeViz 同一个理由）。 -->
    <ProjectReference Include="..\..\src\IslandX.App\IslandX.App.csproj" />
  </ItemGroup>

</Project>
